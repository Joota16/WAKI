APP_NAME=WAKI
DATA_DIR=./data

# Puerto local de Docker Compose. No afecta a la ejecución directa con Uvicorn.
WAKI_PORT=8000
WAKI_BIND_ADDRESS=127.0.0.1

MAX_UPLOAD_MB=8
MAX_PHOTOS=5
MAX_IMAGE_PIXELS=20000000
NORMALIZED_MAX_SIDE=1920
# Tiempo máximo de cada intento de envío del formulario, incluso en redes lentas.
REPORT_UPLOAD_TIMEOUT_SECONDS=120

# Consulta de niveles, caudales y meteorología de SENAMHI (cada hora; mínimo 300 s).
SENAMHI_ENABLED=true
SENAMHI_POLL_SECONDS=3600

# Genera una clave privada para el ESP32. Vacío: las subidas IoT están desactivadas.
IOT_KEY=
IOT_RETENTION_IMAGES=100
# Debe coincidir con el intervalo configurado en el firmware de la cámara.
CAMERA_CAPTURE_SECONDS=60

# Avisos cercanos. La clave Web Push se genera y conserva en DATA_DIR.
PUSH_ENABLED=true
PUSH_SUBJECT=https://waki.jellbru.lat
# Última ubicación compartida válida durante 24 horas; no hay GPS en segundo plano.
PUSH_LOCATION_MAX_AGE_SECONDS=86400

# IA opcional. Para activarla, instalar dependencias y disponer de pesos locales.
MODEL_PROVIDER=none
AI_WATER_CHECKPOINT=weights/segformer_chillon_finetuned
# AI_DINO_CHECKPOINT=weights/grounding-dino-tiny
# AI_YOLOE_CHECKPOINT=weights/yoloe-26s-seg.pt
# AI_YOLOE_PROMPTS=weights/waki_yoloe_prompts.npz
AI_DEVICE=cpu
AI_RIVERS=chillon
AI_RETENTION_IMAGES=100
AI_MAX_PENDING=4
# Construcción Docker con dependencias CPU de IA (más pesada).
WAKI_INSTALL_AI=false

# Cuentas. Vacío: se genera una clave JWT persistente en DATA_DIR/.jwt-secret.
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
# Activa true al servir exclusivamente por HTTPS; false permite localhost HTTP.
AUTH_COOKIE_SECURE=false
# Administrador inicial: se crea solo si no existe. El registro público crea usuarios normales.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=


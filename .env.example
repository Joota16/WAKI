APP_NAME=WAKI
DATA_DIR=./data

# Puerto local de Docker Compose. No afecta a la ejecución directa con Uvicorn.
WAKI_PORT=8000
WAKI_BIND_ADDRESS=127.0.0.1

MAX_UPLOAD_MB=8
MAX_PHOTOS=5
MAX_IMAGE_PIXELS=20000000
NORMALIZED_MAX_SIDE=1920

# Consulta de niveles, caudales y meteorología de SENAMHI (cada hora; mínimo 300 s).
SENAMHI_ENABLED=true
SENAMHI_POLL_SECONDS=3600

# Genera una clave privada para el ESP32. Vacío: las subidas IoT están desactivadas.
IOT_KEY=
IOT_RETENTION_IMAGES=100

